#!/usr/bin/env bash
# Update Allegory to the latest published version, then restart the server.
#
# Install machines are pure checkouts that never make local commits, and the
# public repo's history can be rewritten (squashed release snapshots), so we
# land exactly on origin/main with `reset --hard` rather than `pull` — a pull
# would conflict after a force-push. Everything personal (settings, play
# history, the music library) lives OUTSIDE git, so nothing of yours is
# touched.
#
# Safe to run from a terminal, a .desktop entry, or the in-app Update button
# (the server spawns this detached so it survives its own restart).
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CACHE_DIR="$REPO/.allegory-cache"
LOG_FILE="$CACHE_DIR/update.log"
BRANCH="${ALLEGORY_BRANCH:-main}"
mkdir -p "$CACHE_DIR"
cd "$REPO"

# .desktop / systemd launches start with a stripped-down PATH that omits a
# user-installed node. Prepend the usual locations so `npm` is reachable.
if ! command -v npm >/dev/null 2>&1; then
  for d in "$HOME/.local/node/bin" "/usr/local/bin" "/opt/homebrew/bin"; do
    if [ -x "$d/npm" ]; then export PATH="$d:$PATH"; break; fi
  done
fi

log() { echo "[$(date '+%H:%M:%S')] $*" >>"$LOG_FILE"; }
: > "$LOG_FILE"
log "update starting (branch $BRANCH)"

# Give an in-app caller's HTTP response time to flush before we may kill the
# server it came from. Harmless from a terminal.
sleep 2

# Only reinstall when the lockfile actually changes.
lock_before="$(sha1sum package-lock.json 2>/dev/null | cut -d' ' -f1 || true)"

git fetch origin "$BRANCH" --quiet >>"$LOG_FILE" 2>&1
git reset --hard "origin/$BRANCH" >>"$LOG_FILE" 2>&1
log "synced to $(git rev-parse --short HEAD): $(git log -1 --format=%s)"

lock_after="$(sha1sum package-lock.json 2>/dev/null | cut -d' ' -f1 || true)"
# Reinstall when the lockfile changed, OR when the build toolchain is missing.
# That second guard matters: this machine has intermittently lost
# node_modules/.bin/tsc, and without it `npm run build` dies with
# "tsc: command not found". Since a no-dependency update would otherwise skip
# install, the updater could never heal itself — so the in-app update would
# hang forever. Checking for tsc/vite lets it self-repair.
#
# NODE_ENV=development on the install is load-bearing, not decoration. The
# server spawns this script with no `env` of its own, so we inherit its
# process.env — and under `vite preview` that includes NODE_ENV=production,
# which vite assigns at runtime (so it is invisible in /proc/PID/environ).
# npm turns that into `omit=dev` and quietly deletes vite and typescript, which
# breaks the build AND the restart, since ExecStart is `npm run preview`.
# That was the "intermittent" tsc loss above: it happens on every update from
# the systemd/preview server and never from `npm run dev`. It also made the
# self-repair unreachable, because the repair install inherited the same
# environment and pruned exactly what it was trying to restore.
if [ "$lock_before" != "$lock_after" ] || [ ! -d node_modules ] \
   || [ ! -x node_modules/.bin/tsc ] || [ ! -x node_modules/.bin/vite ]; then
  log "installing dependencies (lockfile changed or build tools missing)"
  NODE_ENV=development npm install --include=dev >>"$LOG_FILE" 2>&1
else
  log "dependencies present — skipping npm install"
fi

# Rebuild the production bundle so a preview/prod server (the only mode where
# the offline service worker runs — it's gated to production builds) picks up
# the new code. Harmless under `npm run dev`, which ignores dist/. Non-fatal:
# a failed build leaves the previous dist in place rather than blocking the
# restart, so a bad commit can never strand the server down.
log "building production bundle"
if npm run build >>"$LOG_FILE" 2>&1; then
  log "build ok"
else
  log "build FAILED — keeping previous dist, continuing to restart"
fi

# The build above is deliberately non-fatal, but a missing vite is a different
# kind of failure: every way we start the server below runs vite, so restarting
# without it takes the library down until someone reaches a terminal — which is
# the one thing an in-app updater must never require. Stop while the old server
# is still serving.
if [ ! -x node_modules/.bin/vite ]; then
  log "FATAL: node_modules/.bin/vite is missing after install."
  log "Refusing to restart — the current server keeps running on the old code."
  log "Recover with: NODE_ENV=development npm install --include=dev"
  exit 1
fi

# Restart. If a systemd user service manages the server, restart it (in a
# transient scope so the service cgroup's teardown doesn't kill this script
# mid-flight). Otherwise stop any vite serving this repo and relaunch detached.
if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet allegory.service 2>/dev/null; then
  log "restarting via systemd user service"
  if command -v systemd-run >/dev/null 2>&1; then
    systemd-run --user --scope --collect systemctl --user restart allegory.service >>"$LOG_FILE" 2>&1 ||
      systemctl --user restart allegory.service >>"$LOG_FILE" 2>&1
  else
    systemctl --user restart allegory.service >>"$LOG_FILE" 2>&1
  fi
else
  log "restarting dev server manually"
  pkill -f "$REPO.*vite" 2>/dev/null || true
  rm -f "$CACHE_DIR/url"
  sleep 1
  setsid nohup npm run dev </dev/null >>"$CACHE_DIR/launcher.log" 2>&1 &
fi

log "update complete"
