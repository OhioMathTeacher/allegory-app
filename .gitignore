# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Per-machine env — committed template is .env.example
/.env
.env.*
!.env.example

# Everything per-machine and private: the resized cover-art cache, but also
# settings.json (holds the Last.fm key), auth.json (the password hash and the
# session signing secret), the listening log and play history, and any mkcert
# TLS material.
.allegory-cache

# Secrets, named explicitly as well. They all live under .allegory-cache/
# today, so these lines are redundant — deliberately. If a later refactor
# moves any of them to the repo root, this is what stops the move from
# quietly publishing a password hash or an API key.
auth.json
settings.json
*.pem
*.key

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Personal editor / IDE workspace files
*.code-workspace

# Library operation logs: these record every file path in the music
# library, which does not belong in a public repo. They are written to
# the maintenance scripts' backup directory (ALLEGORY_BACKUP_DIR) and kept
# in the private dev repo.
tools/library-maintenance/backups/

# Planning docs are dev-only and must never be promoted here. They name
# machines, tailnet addresses and home directories, and they were the reason
# this repo's history had to be rewritten once already. Keep them in the
# private dev repo.
HANDOFF*.md
DESIGN-*.md
version-2-vision.md
tools/library-maintenance/TODO*.md

# Python bytecode from the maintenance scripts
__pycache__/
*.pyc
