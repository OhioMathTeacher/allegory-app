[Desktop Entry]
Type=Application
Version=1.0
Name=Allegory
GenericName=Music Player
Comment=Local-file music player with the Socrates AI sidebar
Exec=__REPO__/bin/allegory-launch
Icon=allegory
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=music;audio;player;allegory;
StartupNotify=true
# Right-click the panel icon. See bin/allegory-playpause.
Actions=PlayPause;
# allegory-launch passes --class Allegory to whichever browser it opens, so
# the app window groups under this icon instead of under Firefox/Chrome.
StartupWMClass=Allegory

[Desktop Action PlayPause]
Name=Pause / Play
Icon=media-playback-pause
Exec=__REPO__/bin/allegory-playpause
